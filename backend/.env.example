# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (encode @ in password as %40)
MONGODB_URI=mongodb+srv://admin:<db_password>@retenza-connect.t5ekkqr.mongodb.net/retenza_connect?retryWrites=true&w=majority&appName=retenza-connect

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
