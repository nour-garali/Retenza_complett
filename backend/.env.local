# Server
PORT=3000
NODE_ENV=development

# MongoDB Local (pour développement/test)
# Décommentez cette ligne si vous utilisez MongoDB local
MONGODB_URI=mongodb://localhost:27017/retenza_connect

# JWT
JWT_SECRET=retenza_connect_dev_secret_key_2026
JWT_EXPIRES_IN=7d

# Password reset token
RESET_TOKEN_EXPIRES_IN=1h

# File uploads
UPLOAD_DIR=uploads

# Base URL for QR code links
APP_BASE_URL=http://localhost:3000

# Admin seed credentials
ADMIN_EMAIL=admin@retenza.com
ADMIN_PASSWORD=Admin123!
